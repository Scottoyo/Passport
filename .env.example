# Supabase project this app talks to. Create a fresh Supabase project for
# the national Passport site — do not point this at any existing
# Orlando/AMI Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used in trusted server contexts only — one-off admin
# scripts, and src/lib/supabase/admin.ts's createAdminClient() (Auth admin
# actions, the transactional-email module's audit log). Never expose to
# the browser or reference from a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The site's own public origin, used to build absolute links (referral
# links, email CTAs) that must resolve correctly regardless of request
# context. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.localperkspassport.com

# Transactional email (Resend - https://resend.com). Used only from
# src/lib/email/ — never referenced from a "use client" file. Create a
# Resend account, verify localperkspassport.com as a sending domain (see
# the project's email setup checklist for the exact DNS steps), then
# generate an API key.
RESEND_API_KEY=your-resend-api-key

# Sender identity for every automated email. EMAIL_REPLY_TO and ADMIN_EMAIL
# are typically the same address, but kept separate since they serve
# different purposes (reply-to header vs. contact-form recipient).
EMAIL_FROM_ADDRESS=no-reply@localperkspassport.com
EMAIL_FROM_NAME=Local Perks Passport
EMAIL_REPLY_TO=admin@localperkspassport.com
ADMIN_EMAIL=admin@localperkspassport.com
