# Supabase project this app talks to. Create a fresh Supabase project for
# the national Passport site — do not point this at any existing
# Orlando/AMI Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used solely in trusted server contexts (e.g. one-off admin
# scripts such as granting the first national admin). Never expose to the
# browser or reference from a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
